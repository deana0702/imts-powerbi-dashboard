			    BLANK()
			)
		formatString: 0
		lineageTag: 4ba173a8-ad21-4326-b302-fcaaf0d252dd

	measure 'Comparable Tests - New' =
			
			VAR SlumpTolerance = 0.5
			VAR AirTolerance = 0.5
			VAR TemperatureTolerance = 5.0
			
			VAR CurrentTestId =
			    SELECTEDVALUE(
			        'CurrentConcreteSpecimenStatus'[ConcreteTestDataId]
