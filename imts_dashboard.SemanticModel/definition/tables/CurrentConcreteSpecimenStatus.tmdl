			            && NOT ISBLANK(CurrentTemperature)
			
			    RETURN
			        IF(
			            NOT HasMeasurements,
			            BLANK(),
			
			            VAR MatchingRows =
			                FILTER(
			                    ALL('HistoricalConcreteBenchmark'),
			
			                    'HistoricalConcreteBenchmark'[TestSubTypeId]
			                        = CurrentSubtype
			
			                        && 'HistoricalConcreteBenchmark'[ConcreteTestUnitSystem]
			                        = CurrentUnit
			
			                        /* Required strength must match */
			                        && 'HistoricalConcreteBenchmark'[RequiredStrength28_psi]
			                        = CurrentRequiredStrength
			
			                        /* Same specimen age */
			                        && 'HistoricalConcreteBenchmark'[BreakAgeDays]
			                        = CurrentAge
			
			                        /* Same curing type */
			                        && 'HistoricalConcreteBenchmark'[CuringType]
			                        = CurrentCuring
			
			                        /* Exclude current test */
			                        && 'HistoricalConcreteBenchmark'[ConcreteTestDataId]
			                        <> CurrentTestId
			
			                        /* Slump +/- 0.5 */
			                        && 'HistoricalConcreteBenchmark'[EffectiveSlump_in]
			                        >= CurrentSlump - SlumpTolerance
			
			                        && 'HistoricalConcreteBenchmark'[EffectiveSlump_in]
			                        <= CurrentSlump + SlumpTolerance
			
			                        /* Air +/- 0.5 */
			                        && 'HistoricalConcreteBenchmark'[EffectiveAir_percent]
			                        >= CurrentAir - AirTolerance
			
			                        && 'HistoricalConcreteBenchmark'[EffectiveAir_percent]
			                        <= CurrentAir + AirTolerance
			
			                        /* Temperature +/- 5 */
			                        && 'HistoricalConcreteBenchmark'[EffectiveConcreteTemp_F]
			                        >= CurrentTemperature - TemperatureTolerance
			
			                        && 'HistoricalConcreteBenchmark'[EffectiveConcreteTemp_F]
			                        <= CurrentTemperature + TemperatureTolerance
			                )
			
			            RETURN
			                COUNTROWS(MatchingRows)
			        )
			)
