	measure 'Upcoming Breaks' =
			
			CALCULATE(
			    COUNTROWS('CurrentConcreteSpecimenStatus'),
			
			    FILTER(
			        'CurrentConcreteSpecimenStatus',
			
			        NOT ISBLANK(
			            'CurrentConcreteSpecimenStatus'[ScheduledTestDate]
			        )
			
			        && 'CurrentConcreteSpecimenStatus'[ScheduledTestDate] >= TODAY()
			
			        && 'CurrentConcreteSpecimenStatus'[HasCompressiveStrengthResult] = 0
			    )
			)
		formatString: 0
		lineageTag: 3cd1613b-c94a-499b-bcf7-11be67517a76

	measure 'Due Next 7 Days' =
			
			CALCULATE(
			    COUNTROWS('CurrentConcreteSpecimenStatus'),
			
			    FILTER(
			        'CurrentConcreteSpecimenStatus',
			
			        NOT ISBLANK(
			            'CurrentConcreteSpecimenStatus'[ScheduledTestDate]
			        )
			
			        && 'CurrentConcreteSpecimenStatus'[ScheduledTestDate] >= TODAY()
			
			        && 'CurrentConcreteSpecimenStatus'[ScheduledTestDate] <= TODAY() + 7
			
			        && 'CurrentConcreteSpecimenStatus'[HasCompressiveStrengthResult] = 0
			    )
			)
		formatString: 0
		lineageTag: 40af56fa-9b0c-4445-8d86-480d753727ac

	measure Overdue =
			
			CALCULATE(
			    COUNTROWS('CurrentConcreteSpecimenStatus'),
			
			    FILTER(
			        'CurrentConcreteSpecimenStatus',
			
			        NOT ISBLANK(
			            'CurrentConcreteSpecimenStatus'[ScheduledTestDate]
			        )
			
			        && 'CurrentConcreteSpecimenStatus'[ScheduledTestDate] < TODAY()
			
			        && 'CurrentConcreteSpecimenStatus'[HasCompressiveStrengthResult] = 0
			    )
			)
		formatString: 0
		lineageTag: cdd1d7f7-f73b-468f-b367-f1a33f3ccad3

	measure '28-Day Complete' =
			
			CALCULATE(
			    DISTINCTCOUNT(
			        'CurrentConcreteSpecimenStatus'[ConcreteTestDataId]
			    ),
			
			    FILTER(
			        'CurrentConcreteSpecimenStatus',
			
			        'CurrentConcreteSpecimenStatus'[BreakAgeDays] = 28
			
			        && 'CurrentConcreteSpecimenStatus'[HasCompressiveStrengthResult] = 1
			    )
			)
		formatString: 0
		lineageTag: abcf0d7a-545a-4a25-9d49-0abff19c4531

	measure 'Requires Review' =
			
			CALCULATE(
			    COUNTROWS('CurrentConcreteSpecimenStatus'),
			
			    FILTER(
			        'CurrentConcreteSpecimenStatus',
			
			        /* 1. Overdue, result missing */
			        (
			            NOT ISBLANK(
			                'CurrentConcreteSpecimenStatus'[ScheduledTestDate]
			            )
			            && 'CurrentConcreteSpecimenStatus'[ScheduledTestDate] < TODAY()
			            && 'CurrentConcreteSpecimenStatus'[HasCompressiveStrengthResult] = 0
			        )
			
			        ||
			
			        /* 2. Tested date recorded, but strength missing */
			        (
			            NOT ISBLANK(
			                'CurrentConcreteSpecimenStatus'[TestedAt]
			            )
			            && 'CurrentConcreteSpecimenStatus'[HasCompressiveStrengthResult] = 0
			        )
			
			        ||
			
			        /* 3. Strength is below required strength */
			        (
			            'CurrentConcreteSpecimenStatus'[HasCompressiveStrengthResult] = 1
			
			            && NOT ISBLANK(
			                'CurrentConcreteSpecimenStatus'[RequiredStrengthAtAge_psi]
			            )
			
			            && 'CurrentConcreteSpecimenStatus'[ActualCompressiveStrength_psi]
			                <
			                'CurrentConcreteSpecimenStatus'[RequiredStrengthAtAge_psi]
			        )
			    )
			)
		formatString: 0
		lineageTag: 2c6853d5-8228-4f54-ac18-092af38a8a1c

