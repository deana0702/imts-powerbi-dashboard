			        'CurrentConcreteSpecimenStatus'[CuringType]
			    )
			
			VAR CurrentRequiredStrength =
			    SELECTEDVALUE(
			        'CurrentConcreteSpecimenStatus'[RequiredStrength28_psi]
			    )
			
			VAR ValidRow =
			    ISINSCOPE(
			        'CurrentConcreteSpecimenStatus'[SpecimenRowId]
			    )
			        && HASONEVALUE(
			            'CurrentConcreteSpecimenStatus'[SpecimenRowId]
