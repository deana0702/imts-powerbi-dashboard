table CurrentConcreteSpecimenStatus
	lineageTag: 65b126e6-b511-4df3-bcbc-251682a3a2ec

	measure 'Historical Avg (psi)' =
			
			// Prototype tolerances: change the same constants in BOTH measures.
			VAR SlumpTolerance = 0.5   // inches
			VAR AirTolerance = 0.5     // percentage points
			VAR TemperatureTolerance = 5.0  // degrees F
			VAR CurrentTestId =
			    SELECTEDVALUE('CurrentConcreteSpecimenStatus'[ConcreteTestDataId])
			VAR CurrentSubtype =
			    SELECTEDVALUE('CurrentConcreteSpecimenStatus'[TestSubTypeId])
			VAR CurrentUnit =
			    SELECTEDVALUE('CurrentConcreteSpecimenStatus'[ConcreteTestUnitSystem])
			VAR CurrentAge =
			    SELECTEDVALUE('CurrentConcreteSpecimenStatus'[BreakAgeDays])
			VAR CurrentCuring =
			    SELECTEDVALUE('CurrentConcreteSpecimenStatus'[CuringType])
			VAR ValidRow =
			    ISINSCOPE('CurrentConcreteSpecimenStatus'[SpecimenRowId])
			        && HASONEVALUE('CurrentConcreteSpecimenStatus'[SpecimenRowId])
			        && NOT ISBLANK(CurrentTestId)
			        && NOT ISBLANK(CurrentSubtype)
			        && CurrentUnit == 0
			        && CurrentAge > 0
			        && CurrentCuring IN { "Standard", "Field" }
			RETURN
			IF(
			    NOT ValidRow,
			    BLANK(),
			    // Read ONLY this current test's measurements; historical results below
			    // come exclusively from the two History tables.
			    VAR CurrentSlump =
			        CALCULATE(
			            SELECTEDVALUE('CurrentConcreteTestStatus'[EffectiveSlump_in]),
			            KEEPFILTERS(
			                TREATAS({ CurrentTestId }, 'CurrentConcreteTestStatus'[ConcreteTestDataId])
			            )
			        )
			    VAR CurrentAir =
			        CALCULATE(
			            SELECTEDVALUE('CurrentConcreteTestStatus'[EffectiveAir_percent]),
			            KEEPFILTERS(
			                TREATAS({ CurrentTestId }, 'CurrentConcreteTestStatus'[ConcreteTestDataId])
			            )
			        )
			    VAR CurrentTemperature =
			        CALCULATE(
			            SELECTEDVALUE('CurrentConcreteTestStatus'[EffectiveConcreteTemp_F]),
			            KEEPFILTERS(
			                TREATAS({ CurrentTestId }, 'CurrentConcreteTestStatus'[ConcreteTestDataId])
			            )
			        )
			    VAR HasMeasurements =
			        NOT ISBLANK(CurrentSlump)
			            && NOT ISBLANK(CurrentAir)
			            && NOT ISBLANK(CurrentTemperature)
			    RETURN
			    IF(
			        NOT HasMeasurements,
			        BLANK(),
			        VAR MatchingTests =
			            FILTER(
			                ALL('ConcreteTestHistory'),
			                'ConcreteTestHistory'[TestSubTypeId] == CurrentSubtype
			                    && 'ConcreteTestHistory'[ConcreteTestUnitSystem] == CurrentUnit
			                    && 'ConcreteTestHistory'[ConcreteTestDataId] <> CurrentTestId
			                    && NOT ISBLANK('ConcreteTestHistory'[EffectiveSlump_in])
			                    && NOT ISBLANK('ConcreteTestHistory'[EffectiveAir_percent])
			                    && NOT ISBLANK('ConcreteTestHistory'[EffectiveConcreteTemp_F])
			                    && 'ConcreteTestHistory'[EffectiveSlump_in] >= CurrentSlump - SlumpTolerance
			                    && 'ConcreteTestHistory'[EffectiveSlump_in] <= CurrentSlump + SlumpTolerance
			                    && 'ConcreteTestHistory'[EffectiveAir_percent] >= CurrentAir - AirTolerance
			                    && 'ConcreteTestHistory'[EffectiveAir_percent] <= CurrentAir + AirTolerance
			                    && 'ConcreteTestHistory'[EffectiveConcreteTemp_F] >= CurrentTemperature - TemperatureTolerance
			                    && 'ConcreteTestHistory'[EffectiveConcreteTemp_F] <= CurrentTemperature + TemperatureTolerance
			            )
			        VAR MatchingTestIds =
			            SELECTCOLUMNS(
			                MatchingTests,
			                "MatchedId", 'ConcreteTestHistory'[ConcreteTestDataId]
			            )
			        // Three matching keys: test ID + BreakAgeDays + CuringType.
			                VAR MatchingSummary =
			                    CALCULATETABLE (
			                        'HistoricalStrengthSummary',
			                        REMOVEFILTERS ( 'ConcreteTestHistory' ),
			                        REMOVEFILTERS ( 'HistoricalStrengthSummary' ),
			                        TREATAS (
			                            MatchingTestIds,
			                            'HistoricalStrengthSummary'[ConcreteTestDataId]
			                        ),
			                        TREATAS (
			                            { CurrentAge },
			                            'HistoricalStrengthSummary'[BreakAgeDays]
			                        ),
			                        TREATAS (
			                            { CurrentCuring },
			                            'HistoricalStrengthSummary'[CuringType]
			                        )
			                    )
			                RETURN
			                    AVERAGEX (
			                        MatchingSummary,
			                        'HistoricalStrengthSummary'[TestAverageStrength_psi]
			                    )
			            )
			        )
		lineageTag: 6dfd1655-1ad9-443e-89c0-0a4c6131b4b1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Comparable Tests' =
			
