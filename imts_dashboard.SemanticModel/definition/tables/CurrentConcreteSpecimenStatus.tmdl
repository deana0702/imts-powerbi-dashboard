			        NOT ISBLANK(CurrentSlump)
			            && NOT ISBLANK(CurrentAir)
			            && NOT ISBLANK(CurrentTemperature)
			    RETURN
			    IF(
			        NOT HasMeasurements,
			        BLANK(),
			        VAR MatchingTests =
			            FILTER(
			                ALL('ConcreteTestHistory'),
			                'ConcreteTestHistory'[TestSubTypeId] == CurrentSubtype
