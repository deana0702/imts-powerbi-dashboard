			                    && NOT ISBLANK('ConcreteTestHistory'[EffectiveSlump_in])
			                    && NOT ISBLANK('ConcreteTestHistory'[EffectiveAir_percent])
			                    && NOT ISBLANK('ConcreteTestHistory'[EffectiveConcreteTemp_F])
			                    && 'ConcreteTestHistory'[EffectiveSlump_in] >= CurrentSlump - SlumpTolerance
			                    && 'ConcreteTestHistory'[EffectiveSlump_in] <= CurrentSlump + SlumpTolerance
			                    && 'ConcreteTestHistory'[EffectiveAir_percent] >= CurrentAir - AirTolerance
			                    && 'ConcreteTestHistory'[EffectiveAir_percent] <= CurrentAir + AirTolerance
			                    && 'ConcreteTestHistory'[EffectiveConcreteTemp_F] >= CurrentTemperature - TemperatureTolerance
			                    && 'ConcreteTestHistory'[EffectiveConcreteTemp_F] <= CurrentTemperature + TemperatureTolerance
			            )
			        VAR MatchingTestIds =
			            SELECTCOLUMNS(
			                MatchingTests,
			                "MatchedId", 'ConcreteTestHistory'[ConcreteTestDataId]
			            )
			        // Three matching keys: test ID + BreakAgeDays + CuringType.
			            VAR MatchingSummary =
			            CALCULATETABLE (
			                'HistoricalStrengthSummary',
			                REMOVEFILTERS ( 'ConcreteTestHistory' ),
			                REMOVEFILTERS ( 'HistoricalStrengthSummary' ),
			                TREATAS (
			                    MatchingTestIds,
			                    'HistoricalStrengthSummary'[ConcreteTestDataId]
			                ),
			                TREATAS (
			                    { CurrentAge },
			                    'HistoricalStrengthSummary'[BreakAgeDays]
			                ),
			                TREATAS (
			                    { CurrentCuring },
			                    'HistoricalStrengthSummary'[CuringType]
			                )
			            )
			        RETURN
			            COALESCE ( COUNTROWS ( MatchingSummary ), 0 )
			    )
			)
		formatString: 0
		lineageTag: 2861bee4-3d18-4fd1-b244-429e1129eb91

	measure 'Specimen Row Rank' =
			
			RANKX(
			    ALLSELECTED(
			        'CurrentConcreteSpecimenStatus'[SpecimenRowId]
			    ),
			    CALCULATE(
			        MIN(
			            'CurrentConcreteSpecimenStatus'[SpecimenRowId]
			        )
			    ),
			    ,
			    ASC,
			    DENSE
			)
		formatString: 0
		lineageTag: 10708ca7-a262-49a1-ad35-976376489ca7

	measure 'Show Specimen On Page' =
			
			VAR CurrentPage =
			    [Current Page]
			
			VAR PageSize =
			    [Page Size]
			
			VAR StartRow =
			    ((CurrentPage - 1) * PageSize) + 1
			
			VAR EndRow =
			    CurrentPage * PageSize
			
			VAR RowNumber =
			    [Specimen Row Rank]
			
			RETURN
			    IF(
			        RowNumber >= StartRow
			            && RowNumber <= EndRow,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 16ce0f40-bab5-4310-92f6-9e05cf3be343

	measure 'Total Specimens' =
			
			DISTINCTCOUNT(
			    'CurrentConcreteSpecimenStatus'[SpecimenRowId]
			)
		formatString: 0
		lineageTag: 9b2809b3-51a3-4027-bbe3-309638e8f9b6

	measure 'Specimen Page Status' =
			
			VAR CurrentPage =
			    [Current Page]
			
			VAR PageSize =
			    [Page Size]
			
			VAR TotalRows =
			    [Total Specimens]
			
			VAR StartRow =
			    IF(
			        TotalRows = 0,
			        0,
			        ((CurrentPage - 1) * PageSize) + 1
			    )
			
			VAR EndRow =
			    MIN(
			        CurrentPage * PageSize,
			        TotalRows
			    )
			
			RETURN
			    IF(
			        TotalRows = 0,
			        "0 / 0",
			        FORMAT(StartRow, "#,0")
			            & "–"
			            & FORMAT(EndRow, "#,0")
			            & " / "
			            & FORMAT(TotalRows, "#,0")
			    )
		lineageTag: 7f22e71b-cb7f-44fc-95df-9867a724fabf

	measure 'Historical Average - Paged' =
			
			IF(
			    [Show Specimen On Page] = 1,
			    [Historical Avg (psi)],
			    BLANK()
			)
		lineageTag: 7c51f699-5fd1-4a6c-ae13-60228c3c9780

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Comparable Count - Paged' =
			
