				    NormalizeMissing = Table.TransformColumns(
				        Source,
				        List.Transform(
				            Table.ColumnNames(Source),
				            (columnName) => {
				                columnName,
				                (value) =>
				                    if value is text then
				                        if Text.Trim(value) = ""
				                            or Text.Upper(Text.Trim(value)) = "NULL"
				                        then null
				                        else value
