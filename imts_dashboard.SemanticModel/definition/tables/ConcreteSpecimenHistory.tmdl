table ConcreteSpecimenHistory
	lineageTag: 879b4f51-47fd-41c0-84fe-19b35544314f

	measure 'Average Strength (psi)' =
			
			AVERAGE(
			    'ConcreteSpecimenHistory'[ActualCompressiveStrength_psi]
			)
		lineageTag: 6e7addf7-0f5b-47cf-98cc-63257e34dab3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Specimens with Results' =
			
			COALESCE(
			    COUNT(
			        ConcreteSpecimenHistory[ActualCompressiveStrength_psi]
			    ),
			    0
			)
		formatString: 0
		lineageTag: c3437298-0476-434c-b2fa-d6dff4ca9ecb

	measure 'Matching Tests' =
			
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT(
			            ConcreteSpecimenHistory[ConcreteTestDataId]
			        ),
			        KEEPFILTERS(
			            NOT ISBLANK(
			                ConcreteSpecimenHistory[ActualCompressiveStrength_psi]
			            )
			        )
			    ),
			    0
			)
		formatString: 0
		lineageTag: cf76ff34-665d-4710-ae5a-302aa5f72d13

	measure 'Average Test Strength (psi)' =
			
			AVERAGEX(
			    VALUES(
			        ConcreteSpecimenHistory[ConcreteTestDataId]
			    ),
			    CALCULATE(
			        AVERAGE(
			            ConcreteSpecimenHistory[ActualCompressiveStrength_psi]
			        )
			    )
			)
		lineageTag: c2d03184-23f9-4c95-b355-6f5b28b60ddd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

